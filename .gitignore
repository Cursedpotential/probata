# =========================
# Python
# =========================
__pycache__/
*.py[codz]
*$py.class

# Packaging / build artifacts
build/
# EXCEPTION (2026-09-05): this vendored Go package embeds its `build/` directory
# with //go:embed, so the blanket `build/` rule above silently un-vendored it and
# every clean clone failed `go build` with
# "pattern build: no matching files found". The assets are 4 files / ~148 KB and
# are part of the vendored module, not our packaging output. Re-include the
# directory first, then its contents — a negation cannot reach into a directory
# that is itself still excluded.
!modules/engine/vendor/github.com/tailscale/web-client-prebuilt/build/
!modules/engine/vendor/github.com/tailscale/web-client-prebuilt/build/**
dist/
*.egg-info/
.eggs/
*.egg

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Type checking / linting
.mypy_cache/
.dmypy.json
.pyre/
.pytype/
.ruff_cache/
.cache

# uv state — requirements.txt is the lockfile of record
uv.lock
# The disposable Surreal runner is intentionally dependency-isolated and owns its lock.
!docker/surreal-phase1-runner/uv.lock
