# Byline: Claude Code · Sonnet (agent) · 2026-07-19
# Byline: Codex · GPT-5 · 2026-08-28 (unified UIW production boundary)
# Byline: Codex · GPT-5.6-Sol · 2026-08-30 (runtime R2 credential contract)
# See compose.workbench.yaml for the deployed values (Coolify renders these
# as literals — env changes need a redeploy).

# Runtime JSON supplies the R2 endpoint and credentials. Bucket names are fixed
# in code: casebible-sorted is read-only source material; nexus is staging.
CASEBIBLE_R2_CONFIG_PATH=/run/secrets/casebible-r2.json
OBJECT_STORE_PREFIX=workbench/staging

# Framework-neutral Platform API (the promote target + the /v1/runs spine).
PLATFORM_API_URL=http://100.72.169.40:8000
PLATFORM_API_BEARER_SECRET_FILE=/run/secrets/platform-api-bearer

# Direct-tailnet Universal Import Workflow starter and upload ingress (ovh-files).
UIW_STARTER_URL=http://100.91.190.107:8091

# Browser access is direct-tailnet only. There is no Workbench password or
# Basic-auth environment setting.

# MCP tool servers for the Tool Explorer — json array of {key,label,url,token?}.
# See app/config/settings.py for the ContextForge auth caveat (JWT required,
# not "no auth on tailnet" as originally assumed).
# ContextForge authors the platform-tools registry; Workbench consumes its
# Portkey-published downstream endpoint rather than a direct MCP door.
# MCP_SERVERS=[{"key":"platform-tools","label":"Platform tools","gateway":"portkey","url":"https://mcp.portkey.ai/horizon-platform-tools/mcp","token_env":"PORTKEY_MCP_API_KEY"}]
# CONTEXTFORGE_TOKEN=optional_minted_jwt

APP_PORT=8020
STATIC_DIR=/app/static
MAX_UPLOAD_MB=200

# Optional absolute root for frozen Proffer DuckDB review bundles.
# PROFFER_PROPOSAL_ROOT=/data/proffer-proposals
