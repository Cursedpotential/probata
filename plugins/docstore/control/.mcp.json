{
  "mcpServers": {
    "docstore-control": {
      "command": "C:/Users/matts/.local/bin/uv.exe",
      "args": ["run", "--frozen", "--no-sync", "--project", "${CLAUDE_PLUGIN_ROOT}", "python", "${CLAUDE_PLUGIN_ROOT}/cli.py", "serve"],
      "env": {
        "DOCSTORE_BASIC_AUTH": "${DOCSTORE_BASIC_AUTH}",
        "DOCSTORE_API_TOKEN": "${DOCSTORE_API_TOKEN:-}",
        "DOCSTORE_CONTROL_ENV_FILE": "${DOCSTORE_CONTROL_ENV_FILE:-C:/Users/matts/.secrets/probata-docstore.env}",
        "DOCSTORE_WORKER_RECEIPTS_DIR": "${DOCSTORE_WORKER_RECEIPTS_DIR:-}",
        "DOCSTORE_PROJECT_REGISTRY": "${DOCSTORE_PROJECT_REGISTRY:-E:/AI_Workspace/Projects/Propria/docs/docstore-source-registry.json}",
        "UV_CACHE_DIR": "E:/AI_Workspace/.intake-dev/uv-cache",
        "TEMP": "E:/AI_Workspace/.intake-dev/temp",
        "TMP": "E:/AI_Workspace/.intake-dev/temp",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    "docstore-surreal": {
      "type": "http",
      "url": "${DOCSTORE_MCP_URL:-https://surreal-docs.tilapia-skilift.ts.net/mcp}",
      "headers": {
        "Authorization": "Basic ${DOCSTORE_BASIC_AUTH}",
        "surreal-ns": "probata",
        "surreal-db": "docs"
      }
    }
  }
}
