#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
UV="/c/Users/matts/.local/bin/uv.exe"
if [[ ! -x "$UV" ]]; then
  echo "Propria Search requires uv at $UV. Install uv or set up the declared pyproject runtime." >&2
  exit 127
fi
exec "$UV" run --project "$ROOT" --locked python "$ROOT/smart_explore.py" "$@"
